{
  "manifest_version": 3,
  "name": "QuickPronounce",
  "version": "1.0.0",
  "description": "Select any word on any page to hear it: IPA, respelling, syllables, and US/UK audio from QuickPronounce.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["contextMenus", "storage", "scripting", "activeTab", "offscreen"],
  "host_permissions": ["https://api.quickpronounce.site/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "QuickPronounce",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_ui": {
    "page": "src/options/options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": [
        "https://*.quickpronounce.site/*",
        "https://quickpronounce.site/*"
      ],
      "js": [
        "src/core/globals.js",
        "src/core/util.js",
        "src/core/config.js",
        "src/core/respell.js",
        "src/core/normalize.js",
        "src/core/audioCache.js",
        "src/content/card.css.js",
        "src/content/card.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "pronounce-selection": {
      "suggested_key": { "default": "Alt+P" },
      "description": "Pronounce the selected text"
    }
  }
}
